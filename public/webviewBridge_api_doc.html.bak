addDoc('treeView', [
  {sig:'向树形框添加子节点', desc:'<span class="desctile"><span class="status-badge">ƒ :</span>treeView.addNode(targetId, parentNodeId, newNode)</b></span>若指定父节点，则作为其子节点添加；父节点会自动展开并切换图标为文件夹。',params:[{n:'targetId',t:'string',d:'树形框控件 ID'},{n:'parentNodeId',t:'string|null',d:'父节点 ID，null 添加到根级'},{n:'newNode',t:'object',d:'{id?, text, children?, expanded?}'}],ret:'boolean — 是否成功',exApi:"// 添加根节点\nwebviewBridge.api.treeView.addNode('treeView_1', null, {\n  text: '新文件夹',\n  children: []\n});\n\n// 添加子节点\nwebviewBridge.api.treeView.addNode('treeView_1', 'node_1', {\n  text: '子文件'\n});",exCmd:'{\n  "command": "treeView.addNode",\n  "targetId": "treeView_1",\n  "parentNodeId": null,\n  "newNode": { "text": "新节点" }\n}'},
  {sig:'从树形框中移除指定节点（及其所有子节点）', desc:'<span class="desctile"><span class="status-badge">ƒ :</span>treeView.removeNode(targetId, nodeId)</b></span>',params:[{n:'targetId',t:'string',d:'树形框控件 ID'},{n:'nodeId',t:'string',d:'要删除的节点 ID'}],ret:'boolean — 是否成功',exApi:"webviewBridge.api.treeView.removeNode('treeView_1', 'node_2');",exCmd:'{\n  "command": "treeView.removeNode",\n  "targetId": "treeView_1",\n  "nodeId": "node_2"\n}'},
  {sig:'更新树节点的文本内容', desc:'<span class="desctile"><span class="status-badge">ƒ :</span>treeView.updateNode(targetId, nodeId, newText)</b></span>',params:[{n:'targetId',t:'string',d:'树形框控件 ID'},{n:'nodeId',t:'string',d:'节点 ID'},{n:'newText',t:'string',d:'新文本'}],ret:'boolean — 是否成功',exApi:"webviewBridge.api.treeView.updateNode('treeView_1', 'node_1', '重命名后的节点');",exCmd:'{\n  "command": "treeView.updateNode",\n  "targetId": "treeView_1",\n  "nodeId": "node_1",\n  "newText": "重命名后的节点"\n}'},
  {sig:'获取树节点的文本内容', desc:'<span class="desctile"><span class="status-badge">ƒ :</span>treeView.getNodeText(targetId, nodeId)</b></span>',params:[{n:'targetId',t:'string',d:'树形框控件 ID'},{n:'nodeId',t:'string',d:'节点 ID'}],ret:'string — 节点文本',exApi:"var text = webviewBridge.api.treeView.getNodeText('treeView_1', 'node_1');\nconsole.log(text);",exCmd:'{\n  "command": "treeView.getNodeText",\n  "targetId": "treeView_1",\n  "nodeId": "node_1"\n}'},
  {sig:'展开树节点，显示其子节点', desc:'<span class="desctile"><span class="status-badge">ƒ :</span>treeView.expandNode(targetId, nodeId)</b></span>',params:[{n:'targetId',t:'string',d:'树形框控件 ID'},{n:'nodeId',t:'string',d:'节点 ID'}],ret:'boolean — 是否成功',exApi:"webviewBridge.api.treeView.expandNode('treeView_1', 'node_1');",exCmd:'{\n  "command": "treeView.expandNode",\n  "targetId": "treeView_1",\n  "nodeId": "node_1"\n}'},
  {sig:'折叠树节点，隐藏其子节点', desc:'<span class="desctile"><span class="status-badge">ƒ :</span>treeView.collapseNode(targetId, nodeId)</b></span>',params:[{n:'targetId',t:'string',d:'树形框控件 ID'},{n:'nodeId',t:'string',d:'节点 ID'}],ret:'boolean — 是否成功',exApi:"webviewBridge.api.treeView.collapseNode('treeView_1', 'node_1');",exCmd:'{\n  "command": "treeView.collapseNode",\n  "targetId": "treeView_1",\n  "nodeId": "node_1"\n}'},
  {sig:'展开树形框所有节点', desc:'<span class="desctile"><span class="status-badge">ƒ :</span>treeView.expandAll(targetId)</b></span>',params:[{n:'targetId',t:'string',d:'树形框控件 ID'}],ret:'boolean — 是否成功',exApi:"webviewBridge.api.treeView.expandAll('treeView_1');",exCmd:'{\n  "command": "treeView.expandAll",\n  "targetId": "treeView_1"\n}'},
  {sig:'折叠树形框所有节点', desc:'<span class="desctile"><span class="status-badge">ƒ :</span>treeView.collapseAll(targetId)</b></span>',params:[{n:'targetId',t:'string',d:'树形框控件 ID'}],ret:'boolean — 是否成功',exApi:"webviewBridge.api.treeView.collapseAll('treeView_1');",exCmd:'{\n  "command": "treeView.collapseAll",\n  "targetId": "treeView_1"\n}'},
  {sig:'选中指定树节点（添加 visual 高亮样式）', desc:'<span class="desctile"><span class="status-badge">ƒ :</span>treeView.selectNode(targetId, nodeId)</b></span>',params:[{n:'targetId',t:'string',d:'树形框控件 ID'},{n:'nodeId',t:'string',d:'节点 ID'}],ret:'boolean — 是否成功',exApi:"webviewBridge.api.treeView.selectNode('treeView_1', 'node_2');",exCmd:'{\n  "command": "treeView.selectNode",\n  "targetId": "treeView_1",\n  "nodeId": "node_2"\n}'},
  {sig:'获取当前选中的树节点 ID', desc:'<span class="desctile"><span class="status-badge">ƒ :</span>treeView.getSelectedNode(targetId)</b></span>无选中时返回空字符串。',params:[{n:'targetId',t:'string',d:'树形框控件 ID'}],ret:'string — 选中节点 ID，空字符串表示无',exApi:"var nodeId = webviewBridge.api.treeView.getSelectedNode('treeView_1');\nif (nodeId) console.log('选中:', nodeId);",exCmd:'{\n  "command": "treeView.getSelectedNode",\n  "targetId": "treeView_1"\n}'},
  {sig:'获取当前高亮的树节点（单击或右键选中）', desc:'<span class="desctile"><span class="status-badge">ƒ :</span>treeView.getHighlightedNode(targetId)</b></span>返回节点 ID、文本和 DOM 引用。无高亮节点返回 null。与右键菜单配合使用，先右键高亮再通过该 API 获取。',params:[{n:'targetId',t:'string',d:'树形框控件 ID'}],ret:'object|null — { nodeId, text, element } 或 null',exApi:"var node = webviewBridge.api.treeView.getHighlightedNode('treeView_1');\nif (node) {\n  console.log('高亮节点ID:', node.nodeId);\n  console.log('高亮节点文本:', node.text);\n}",exCmd:'{\n  "command": "treeView.getHighlightedNode",\n  "targetId": "treeView_1"\n}'},
  {sig:'取消指定树节点的选中高亮', desc:'<span class="desctile"><span class="status-badge">ƒ :</span>treeView.deselectNode(targetId, nodeId)</b></span>移除该节点的 .treeView_node_content .selected 类名。',params:[{n:'targetId',t:'string',d:'树形框控件 ID'},{n:'nodeId',t:'string',d:'节点 ID'}],ret:'boolean — 是否成功',exApi:"webviewBridge.api.treeView.deselectNode('treeView_1', 'node_2');",exCmd:'{\n  "command": "treeView.deselectNode",\n  "targetId": "treeView_1",\n  "nodeId": "node_2"\n}'},
  {sig:'清除树形框当前的选中高亮', desc:'<span class="desctile"><span class="status-badge">ƒ :</span>treeView.clearSelection(targetId)</b></span>移除 .treeView_node_content 上的 .selected 类名。',params:[{n:'targetId',t:'string',d:'树形框控件 ID'}],ret:'boolean — 是否成功',exApi:"webviewBridge.api.treeView.clearSelection('treeView_1');",exCmd:'{\n  "command": "treeView.clearSelection",\n  "targetId": "treeView_1"\n}'},
  {sig:'设置是否始终显示选中高亮', desc:'<span class="desctile"><span class="status-badge">ƒ :</span>treeView.setAlwaysShowSelection(targetId, enabled)</b></span>设置容器 data-always-show-selection 属性，控制点击其他控件时是否保留当前选中高亮。',params:[{n:'targetId',t:'string',d:'树形框控件 ID'},{n:'enabled',t:'boolean',d:'true=始终显示'}],ret:'boolean — 是否成功',exApi:"webviewBridge.api.treeView.setAlwaysShowSelection('treeView_1', true);",exCmd:'{\n  "command": "treeView.setAlwaysShowSelection",\n  "targetId": "treeView_1",\n  "enabled": true\n}'},
  {sig:'获取是否始终显示选中高亮', desc:'<span class="desctile"><span class="status-badge">ƒ :</span>treeView.getAlwaysShowSelection(targetId)</b></span>',params:[{n:'targetId',t:'string',d:'树形框控件 ID'}],ret:'boolean — 是否始终显示',exApi:"var show = webviewBridge.api.treeView.getAlwaysShowSelection('treeView_1');\nconsole.log('始终显示:', show);",exCmd:'{\n  "command": "treeView.getAlwaysShowSelection",\n  "targetId": "treeView_1"\n}'},
