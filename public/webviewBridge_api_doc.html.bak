  {sig:'按索引删除列表框中指定项', desc:'<span class="desctile"><span class="status-badge">ƒ :</span>listBox.removeItem(targetId, index)</b></span>',params:[{n:'targetId',t:'string',d:'列表框控件 ID'},{n:'index',t:'number',d:'要删除的项索引'}],ret:'boolean — 是否成功',exApi:"webviewBridge.api.listBox.removeItem('listBox_1', 0);",exCmd:'{\n  "command": "listBox.removeItem",\n  "targetId": "listBox_1",\n  "index": 0\n}'},
  {sig:'清空列表框所有项目', desc:'<span class="desctile"><span class="status-badge">ƒ :</span>listBox.clearItems(targetId)</b></span>',params:[{n:'targetId',t:'string',d:'列表框控件 ID'}],ret:'boolean — 是否成功',exApi:"webviewBridge.api.listBox.clearItems('listBox_1');",exCmd:'{\n  "command": "listBox.clearItems",\n  "targetId": "listBox_1"\n}'},
  {sig:'获取列表框项目总数', desc:'<span class="desctile"><span class="status-badge">ƒ :</span>listBox.getItemCount(targetId)</b></span>',params:[{n:'targetId',t:'string',d:'列表框控件 ID'}],ret:'number — 项目数量',exApi:"var count = webviewBridge.api.listBox.getItemCount('listBox_1');\nconsole.log('项数:', count);",exCmd:'{\n  "command": "listBox.getItemCount",\n  "targetId": "listBox_1"\n}'},
  {sig:'设置列表框中指定项的文本', desc:'<span class="desctile"><span class="status-badge">ƒ :</span>listBox.setItemText(targetId, index, text)</b></span>',params:[{n:'targetId',t:'string',d:'列表框控件 ID'},{n:'index',t:'number',d:'项索引'},{n:'text',t:'string',d:'新文本'}],ret:'boolean — 是否成功',exApi:"webviewBridge.api.listBox.setItemText('listBox_1', 2, '修改后的文本');",exCmd:'{\n  "command": "listBox.setItemText",\n  "targetId": "listBox_1",\n  "index": 2,\n  "text": "修改后的文本"\n}'},
  {sig:'获取列表框中指定项的文本', desc:'<span class="desctile"><span class="status-badge">ƒ :</span>listBox.getItemText(targetId, index)</b></span>',params:[{n:'targetId',t:'string',d:'列表框控件 ID'},{n:'index',t:'number',d:'项索引'}],ret:'string — 项文本',exApi:"var text = webviewBridge.api.listBox.getItemText('listBox_1', 1);\nconsole.log('第2项:', text);",exCmd:'{\n  "command": "listBox.getItemText",\n  "targetId": "listBox_1",\n  "index": 1\n}'},
  {sig:'设置列表框中指定项的勾选状态（需列表支持复选框）', desc:'<span class="desctile"><span class="status-badge">ƒ :</span>listBox.setItemChecked(targetId, index, checked)</b></span>',params:[{n:'targetId',t:'string',d:'列表框控件 ID'},{n:'index',t:'number',d:'项索引'},{n:'checked',t:'boolean',d:'true=勾选'}],ret:'boolean — 是否成功',exApi:"webviewBridge.api.listBox.setItemChecked('listBox_1', 0, true);",exCmd:'{\n  "command": "listBox.setItemChecked",\n  "targetId": "listBox_1",\n  "index": 0,\n  "checked": true\n}'},
