addDoc('logOutput', [
  {sig:'向日志框添加一条日志', desc:'<span class="desctile"><span class="status-badge">ƒ :</span>logOutput.addLog(targetId, text, color, wrap)</b></span>可指定颜色，默认为黑色。wrap=false 时多条日志可同行排列。',params:[{n:'targetId',t:'string',d:'日志框控件 ID'},{n:'text',t:'string',d:'日志文本'},{n:'color',t:'string',d:'（可选）文本颜色，默认 #000000'},{n:'wrap',t:'boolean',d:'（可选）是否换行，默认 true（每行独立）。false 时多条日志同行排列'}],ret:'boolean — 是否成功',exApi:"// 普通日志\nwebviewBridge.api.logOutput.addLog('logOutput_1', '服务启动成功');\n\n// 彩色日志\nwebviewBridge.api.logOutput.addLog('logOutput_1', '错误：连接失败', '#ff0000');\n\n// 多段同行（不换行）\nwebviewBridge.api.logOutput.addLog('logOutput_1', '[12:00]', '#888', false);\nwebviewBridge.api.logOutput.addLog('logOutput_1', '操作成功', '#0a0', false);\nwebviewBridge.api.logOutput.addLog('logOutput_1', '(耗时 120ms)', '#666', false);",exCmd:'{\n  "command": "logOutput.addLog",\n  "targetId": "logOutput_1",\n  "text": "错误：连接失败",\n  "color": "#ff0000",\n  "wrap": true\n}'},
  {sig:'向日志框添加一条富文本HTML日志', desc:'<span class="desctile"><span class="status-badge">ƒ :</span><b>★ 新增</b> logOutput.addHtmlLog(targetId, html)</b></span>支持任意 HTML 标签和内联样式，可实现每字/每行不同颜色、大小、字体等。',params:[{n:'targetId',t:'string',d:'日志框控件 ID'},{n:'html',t:'string',d:'HTML 内容字符串，任意合法 HTML'}],ret:'boolean — 是否成功',exApi:"// 1. 不同颜色混合\nwebviewBridge.api.logOutput.addHtmlLog('logOutput_1',\n  '<span style=\"color:#ff0000\">红色</span> + <span style=\"color:#00ff00\">绿色</span> + <span style=\"color:#0000ff\">蓝色</span>'\n);\n\n// 2. 每字不同样式\nwebviewBridge.api.logOutput.addHtmlLog('logOutput_1',\n  '<span style=\"color:red;font-size:18px\">大</span>'\n+ '<span style=\"color:orange;font-weight:bold\">小</span>'\n+ '<span style=\"color:green;text-decoration:underline\">不</span>'\n+ '<span style=\"color:blue;font-style:italic\">一</span>'\n+ '<span style=\"color:purple;font-size:20px\">样</span>'\n);\n\n// 3. 带图标的日志\nwebviewBridge.api.logOutput.addHtmlLog('logOutput_1',\n  '<span style=\"color:#888\">[2024-01-01 12:00:00]</span> '\n+ '<span style=\"color:#00aa00\">✔ 操作成功</span> — '\n+ '<span style=\"color:#666\">用户 admin 登录系统</span>'\n);\n\n// 4. 表格日志\nwebviewBridge.api.logOutput.addHtmlLog('logOutput_1',\n  '<table style=\"border-collapse:collapse;width:100%;font-size:12px\">'\n+ '<tr style=\"background:#f0f0f0\"><td style=\"padding:4px;border:1px solid #ddd\">键</td><td style=\"padding:4px;border:1px solid #ddd\">值</td></tr>'\n+ '<tr><td style=\"padding:4px;border:1px solid #ddd\">状态</td><td style=\"padding:4px;border:1px solid #ddd\">成功</td></tr>'\n+ '<tr><td style=\"padding:4px;border:1px solid #ddd\">耗时</td><td style=\"padding:4px;border:1px solid #ddd\">120ms</td></tr>'\n+ '</table>'\n);\n\n// 5. 带链接的日志\nwebviewBridge.api.logOutput.addHtmlLog('logOutput_1',\n  '点击 <a href=\"#\" style=\"color:#0078d4\">这里</a> 查看详情'\n);",exCmd:'{\n  "command": "logOutput.addHtmlLog",\n  "targetId": "logOutput_1",\n  "html": "<span style=\\"color:red\\">红色</span> + <span style=\\"color:green\\">绿色</span>"\n}'},
  {sig:'清空日志框所有日志', desc:'<span class="desctile"><span class="status-badge">ƒ :</span>logOutput.clearLog(targetId)</b></span>',params:[{n:'targetId',t:'string',d:'日志框控件 ID'}],ret:'boolean — 是否成功',exApi:"webviewBridge.api.logOutput.clearLog('logOutput_1');",exCmd:'{\n  "command": "logOutput.clearLog",\n  "targetId": "logOutput_1"\n}'},
  {sig:'获取日志框中的日志条数', desc:'<span class="desctile"><span class="status-badge">ƒ :</span>logOutput.getLogCount(targetId)</b></span>',params:[{n:'targetId',t:'string',d:'日志框控件 ID'}],ret:'number — 日志条数',exApi:"var count = webviewBridge.api.logOutput.getLogCount('logOutput_1');\nconsole.log('日志数:', count);",exCmd:'{\n  "command": "logOutput.getLogCount",\n  "targetId": "logOutput_1"\n}'}
]);

// ==================== 容器控件 ====================
